{
  "name": "nakliyeborsasi",
  "private": true,
  "workspaces": [
    "core",
    "apps/api",
    "apps/web",
    "apps/mail-web",
    "apps/mail-console",
    "apps/mail-marketing"
  ],
  "scripts": {
    "verify-root": "bash scripts/verify-project-root.sh",
    "preinstall": "node -e \"if(!require('fs').existsSync('package.json'))process.exit(1)\"",
    "build": "npm run verify-root && npm run build -w core && npm run build -w @nakliyeborsasi/api",
    "build:all": "npm run build && npm run build -w @nakliyeborsasi/web && npm run build -w @lerta/mail-web && npm run build -w @lerta/mail-console && npm run build -w @lerta/mail-marketing",
    "start": "npm run verify-root && npm run start -w @nakliyeborsasi/api",
    "start:web": "npm run start -w @nakliyeborsasi/web",
    "start:dev": "npm run verify-root && npm run start:dev -w @nakliyeborsasi/api",
    "lint": "npm run lint -w @nakliyeborsasi/api",
    "test:unit": "npm run test -w @nakliyeborsasi/core",
    "test:api": "npm run test -w @nakliyeborsasi/api",
    "test:e2e": "npm run test:e2e -w @nakliyeborsasi/web",
    "verify:vps": "bash scripts/vps-operator-verify.sh",
    "archive:move": "bash scripts/archive-replaced-source.sh",
    "git:cleanup-merged": "bash scripts/cleanup-merged-git-branches.sh",
    "git:cleanup-merged:apply": "DRY_RUN=0 APPLY=1 bash scripts/cleanup-merged-git-branches.sh",
    "git:archive-stale-branches": "bash scripts/archive-stale-branches-as-tags.sh",
    "git:archive-stale-branches:apply": "DRY_RUN=0 APPLY=1 bash scripts/archive-stale-branches-as-tags.sh"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0"
  },
  "optionalDependencies": {
    "@next/swc-linux-x64-gnu": "15.5.28",
    "@next/swc-linux-x64-musl": "15.5.28"
  },
  "overrides": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1"
  }
}
