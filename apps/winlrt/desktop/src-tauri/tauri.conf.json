{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WinLRT",
  "version": "0.1.0",
  "identifier": "com.lerta.winlrt",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "WinLRT",
        "width": 960,
        "height": 720,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["ltr"],
        "name": "Lerta Document",
        "description": "Lerta Document (LTR)",
        "mimeType": "application/vnd.lerta.document+html",
        "role": "Viewer",
        "rank": "Owner",
        "contentTypes": ["com.lerta.document.ltr"],
        "exportedType": {
          "identifier": "com.lerta.document.ltr",
          "conformsTo": ["public.data", "public.content"]
        }
      }
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "shortDescription": "LTR (.ltr) belge görüntüleyici",
    "longDescription": "WinLRT, Lerta Document (.ltr) dosyalarını açar. Posta ve mesajlaşmadan bağımsız çalışır."
  }
}
