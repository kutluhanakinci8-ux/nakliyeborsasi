{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.lerta.com.tr/ltr/spec/ltr-1.0.schema.json",
  "title": "Lerta Document manifest (lerta/ltr/1.0)",
  "type": "object",
  "required": ["schema", "lang", "mode", "title", "blocks"],
  "additionalProperties": true,
  "properties": {
    "schema": { "const": "lerta/ltr/1.0" },
    "lang": { "type": "string", "minLength": 2 },
    "mode": { "enum": ["sealed", "linked"] },
    "title": { "type": "string", "minLength": 1 },
    "subtitle": { "type": "string" },
    "meta": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "author": { "type": "string" },
        "organization": { "type": "string" },
        "createdAt": { "type": "string" },
        "generator": { "type": "string" }
      }
    },
    "blocks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type"],
        "properties": {
          "type": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
