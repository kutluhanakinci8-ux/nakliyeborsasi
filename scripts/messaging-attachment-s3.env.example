# Mesajlar / Telegram DM ekleri — 10 MB üzeri için S3 (VPS .env örneği)
# MESSAGING_ATTACHMENT_S3_BUCKET=lerta-messaging-attachments-prod
# MESSAGING_ATTACHMENT_S3_REGION=eu-central-1
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# MESSAGING_ATTACHMENT_S3_MAX_BYTES=52428800
# MESSAGING_ATTACHMENT_COMPANY_MONTHLY_QUOTA_BYTES=536870912
# MinIO: MESSAGING_ATTACHMENT_S3_ENDPOINT=https://... MESSAGING_ATTACHMENT_S3_FORCE_PATH_STYLE=1
