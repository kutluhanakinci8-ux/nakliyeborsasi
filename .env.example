NODE_ENV=development
PORT=3010
DEFAULT_LOCALE=tr
DATABASE_URL=postgresql://nakliyeborsasi:nakliyeborsasi@localhost:5432/nakliyeborsasi
REDIS_URL=redis://localhost:6379
# OSRM (Faz A–B): demo router or self-host — see docker-compose.osrm.yml
OSRM_BASE_URL=https://router.project-osrm.org
# OSRM_BASE_URL_TR=http://localhost:5000
# OSRM_DISABLED=true
# KAFKA_BROKERS=localhost:9092
# logistics_poi: LOGISTICS_POI_SEED_OVERPASS=true (bir kez TR OSM), LOGISTICS_POI_SKIP_SAMPLE=true
# LOGISTICS_POI_OVERPASS_URL=https://overpass.kumi.systems/api/interpreter
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_EXPIRES_IN=12h
TYPEORM_SYNCHRONIZE=true
# E-posta — tamamen kendi platform + kendi MTA (docs/EMAIL_PHASE_A_DNS_ISIMTESCIL.md)
EMAIL_ENABLED=true
PLATFORM_ADMIN_EMAILS=admin@lerta.tr,notifications@mail.lerta.tr
# Geliştirme: mailpit | Üretim: custom + VPS Postfix
SMTP_PROFILE=mailpit
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM=Lerta Logistics <notifications@mail.lerta.tr>
# Faz A — platform gönderim domain (isimtescil: lerta.tr)
MAIL_PLATFORM_DOMAIN=mail.lerta.tr
MAIL_PLATFORM_FROM_EMAIL=notifications@mail.lerta.tr
# MAIL_PLATFORM_SPF_IPV4=168.x.x.x
# MAIL_PLATFORM_SPF_TXT=v=spf1 ip4:168.x.x.x -all
# MAIL_PLATFORM_DKIM_SELECTOR=default
# MAIL_PLATFORM_DKIM_HOST=default._domainkey.mail.lerta.tr
# MAIL_PLATFORM_DKIM_TXT=v=DKIM1; k=rsa; p=...
# MAIL_PLATFORM_DMARC_HOST=_dmarc.lerta.tr
# Faz B — paylaşımlı tenant alt alan (kullanici.lerta.tr)
# MAIL_PLATFORM_TENANT_DOMAIN=kullanici.lerta.tr
# MAIL_PLATFORM_TENANT_DKIM_TXT=v=DKIM1; h=sha256; k=rsa; p=...
# Üretim örnek:
# SMTP_PROFILE=custom
# SMTP_HOST=127.0.0.1
# SMTP_PORT=25
# SMTP_SECURE=false
WEB_PUBLIC_BASE_URL=http://localhost:3011
# Faz A: admin'e her giriş maili (varsayılan kapalı)
# PLATFORM_ADMIN_NOTIFY_USER_LOGIN=true
# PLATFORM_OWNER_BOOTSTRAP_PASSWORD=822159Ka
# PLATFORM_OWNER_FORCE_BOOTSTRAP_PASSWORD=true
INTEGRATION_CACHE_TTL_SECONDS=120
INTEGRATION_RATE_LIMIT_PER_MINUTE=30
LARDI_TRANS_API_BASE_URL=
DELLA_API_BASE_URL=
DAT_API_BASE_URL=
TRUCKSTOP_API_BASE_URL=
SENNDER_API_BASE_URL=
FREIGHTOS_SHIPPING_CALCULATOR_URL=https://ship.freightos.com/api/shippingCalculator
INTEGRATION_HTTP_TIMEOUT_MS=8000
